{
  "name": "plugga",
  "version": "0.1.0",
  "private": true,
  "description": "Plugga – en studieplattform för Biologi 2 (Study Kit).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs vite",
    "build": "npm run check && npm run typecheck && node scripts/run.mjs vite build --mode site && node scripts/run.mjs vite build --mode backup",
    "preview": "node scripts/run.mjs vite preview --mode site --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "node scripts/check-content.ts",
    "pretest": "npm run build",
    "test": "node scripts/run.mjs playwright test",
    "shots": "node scripts/run.mjs playwright test -c playwright.shots.config.ts",
    "extract": "python -I scripts/extract_material.py material/prov1 material/_extracted/prov1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4"
  },
  "engines": {
    "node": ">=24"
  }
}
